classDiagram
    %% Core domain entities
    class User {
        - String email
        - String fullName
        - String password
        - String role
        - String profilePic
        - Object privacy
        - Object preferences
        + Boolean checkProfileCompleteness()
        + Object verifyEmailOTP(otp)
    }

    class Message {
        - Object senderId
        - Object receiverId
        - String text
        - String image
        - Boolean delivered
        - Boolean seen
    }

    %% Controllers / Services / Stores
    class AuthController {
        + Promise signup(req, res)
        + Promise login(req, res)
        + void logout(req, res)
    }

    class ProfileController {
        + Promise updateProfile(req, res)
        + Promise updatePrivacySettings(req, res)
    }

    class MessageController {
        + Promise getMessagesByUserId(req, res)
        + Promise sendMessage(req, res)
        + Promise markAsSeen(req, res)
    }

    class TranslationService {
        + Promise translateText(text, fromLang, toLang)
        + Promise detectLanguage(text)
    }

    class SocketManager {
        - Server io
        - Object userSocketMap
        + String getReceiverSocketId(userId)
    }

    class useAuthStore {
        - Object authUser
        - Socket socket
        + Promise login(data)
        + Promise logout()
    }

    class useChatStore {
        - Array messages
        - Object selectedUser
        + Promise sendMessage(messageData)
        + Promise getMessagesByUserId(userId)
    }

    %% Relationships (with labels inspired by your diagram)
    AuthController --> User : authenticates
    ProfileController --> User : updates

    %% Users send/receive messages
    User "1" -- "*" Message : sends/receives

    %% Controllers and stores manage messages
    MessageController --> Message : manages
    useChatStore o-- Message : manages

    %% Stores / managers interaction
    useAuthStore o-- User : stores
    SocketManager ..> MessageController : tracks socket

    %% Services operating on messages
    TranslationService ..> Message : translates

    %% Controller uses user context
    MessageController ..> User : uses



